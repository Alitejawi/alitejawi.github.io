---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Chip from '../components/Chip.astro';
import ContentsReceipt from '../components/ContentsReceipt.astro';
import { site } from '../data/site';

interface Props {
  kicker: string;
  chip?: string;
  minutes: number;
  title: string;
  lede: string;
  headings: { depth: number; slug: string; text: string }[];
  extraReceipt?: { title: string; lines: { label: string; value: string }[] };
  prev?: { href: string; label: string; title: string };
  next?: { href: string; label: string; title: string };
}

const { kicker, chip, minutes, title, lede, headings, extraReceipt, prev, next } = Astro.props;
const hasContents = headings.some((heading) => heading.depth === 2);
const current = Astro.url.pathname.startsWith('/projects/') ? 'projects' : 'writing';
---

<Base title={`${title} · ${site.name}`} description={lede}>
  <Nav slot="nav" current={current} />
  <article class:list={['article', { 'has-contents': hasContents }]}>
    <header class="article-header">
      <div class="article-kicker">
        <span>{kicker}</span>
        {chip && <Chip text={chip} />}
        <span>{minutes} min read</span>
      </div>
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
      <slot name="metadata" />
    </header>
    <ContentsReceipt headings={headings} extraReceipt={extraReceipt} />
    <div class="article-body"><slot /></div>
    {(prev || next || Astro.slots.has('footer')) && (
      <footer class="article-footer">
        {(prev || next) && (
          <nav class="article-pagination" aria-label="Adjacent field notes">
            {prev && (
              <a href={prev.href} rel="prev">
                <span class="label">← {prev.label}</span>
                <span class="adjacent-title">{prev.title}</span>
              </a>
            )}
            {next && (
              <a class="next" href={next.href} rel="next">
                <span class="label">{next.label} →</span>
                <span class="adjacent-title">{next.title}</span>
              </a>
            )}
          </nav>
        )}
        <slot name="footer" />
      </footer>
    )}
  </article>
</Base>

<script>
  import '../components/CodeBlock';
</script>

<style>
  .article {
    display: grid;
    grid-template-columns: minmax(0, 640px);
    justify-content: center;
    column-gap: clamp(2rem, 5vw, 4rem);
  }

  .article.has-contents {
    grid-template-columns: minmax(0, 640px) 260px;
  }

  .article-header,
  .article-body,
  .article-footer {
    grid-column: 1;
    min-width: 0;
  }

  .article-header {
    margin-bottom: 2.5rem;
  }

  .article-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem 0.75rem;
    margin-bottom: 1.125rem;
    color: var(--dark-grey);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  h1 {
    margin-bottom: 1.125rem;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .lede {
    margin: 0;
    color: var(--dark-grey);
    font-size: 1.1875rem;
    line-height: 1.5;
  }

  .article-body {
    counter-reset: section;
    font-size: 1.09375rem;
    line-height: 1.7;
  }

  .article-body :global(p) {
    margin-bottom: 1.25rem;
  }

  .article-body :global(> :first-child) {
    margin-top: 0;
  }

  .article-body :global(> h2) {
    display: flex;
    align-items: baseline;
    gap: 0.875rem;
    margin: 3rem 0 1rem;
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
    scroll-margin-top: 1.5rem;
    counter-increment: section;
  }

  .article-body :global(> h2::before) {
    content: counter(section, decimal-leading-zero);
    flex-shrink: 0;
    color: var(--dark-grey);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .article-body :global(> h1),
  .article-body :global(> h3) {
    margin: 2rem 0 1rem;
    font-size: 1.25rem;
    line-height: 1.4;
  }

  .article-body :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }

  .article-body :global(:not(pre) > code) {
    padding: 0.0625rem 0.3125rem;
    border-radius: 0.25rem;
    background: var(--ghost-grey);
    font-size: 0.86em;
    overflow-wrap: anywhere;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .article-body :global(pre),
  .article-body :global(.code-block) {
    min-width: 0;
    max-width: 100%;
    border-radius: 0.625rem;
    background-color: var(--ink) !important;
    background-image: radial-gradient(rgb(255 255 255 / 6%) 1px, transparent 1px);
    background-size: 3px 3px;
  }

  .article-body :global(pre) {
    margin: 0.5rem 0 1.625rem;
    padding: 1rem;
    overflow-x: auto;
    white-space: pre;
    overflow-wrap: normal;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .article-body :global(pre code) {
    font-size: inherit;
  }

  .article-body :global(.code-block) {
    margin: 0.5rem 0 1.625rem;
    color: var(--paper);
  }

  .article-body :global(.code-block pre) {
    margin: 0;
    border-radius: 0 0 0.625rem 0.625rem;
  }

  .article-body :global(.code-bar) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5625rem 1rem;
    border-bottom: 1px solid var(--dark-grey);
    color: var(--mid-grey);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .article-body :global(.code-bar button) {
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--dark-grey);
    border-radius: 0.25rem;
    background: transparent;
    color: var(--paper);
    text-transform: inherit;
    cursor: pointer;
  }

  .article-body :global(.code-bar button:hover) {
    border-color: var(--accent);
  }

  .article-body :global(pre:focus-visible),
  .article-body :global(.code-bar button:focus-visible) {
    outline-color: var(--accent);
  }

  .article-body :global(.code-status) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .article-footer {
    margin-top: 3.5rem;
    padding-top: 1.125rem;
    border-top: 1px solid var(--mid-grey);
  }

  .article-pagination {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .article-pagination a {
    text-decoration: none;
  }

  .article-pagination a:hover .adjacent-title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .adjacent-title {
    display: block;
    margin-top: 0.375rem;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .next {
    grid-column: 2;
    text-align: right;
  }

  @media (width < 900px) {
    .article.has-contents {
      grid-template-columns: minmax(0, 640px);
    }
  }
</style>
