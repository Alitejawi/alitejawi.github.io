---
import '../styles/global.css';
import geistBody from '@fontsource/geist-sans/files/geist-sans-latin-400-normal.woff2?url';
import geistMono from '@fontsource/geist-mono/files/geist-mono-latin-400-normal.woff2?url';
import { site } from '../data/site';
import SiteFooter from '../components/SiteFooter.astro';
import Nav from '../components/Nav.astro';
import ReadmeNote from '../components/ReadmeNote.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Keep this page out of search results (used by the not-found page). */
  noindex?: boolean;
}

const { title, description, ogImage = '/assets/img/og.png', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url);
const socialImage = new URL(ogImage, site.url);
const section = Astro.url.pathname.split('/')[1];
const current = section === 'posts' || section === 'writing' ? 'writing'
  : section === 'projects' || section === 'now' || section === 'about' ? section
  : undefined;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: site.role,
  sameAs: [site.links.github, site.links.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/img/favicons/favicon.ico" sizes="any" />
    <link rel="icon" href="/assets/img/favicons/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/img/favicons/apple-touch-icon.png" />
    <link rel="preload" href={geistBody} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMono} as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/feed.xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${site.headline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={`${site.name}: ${site.headline}`} />
    <script type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="nav"><Nav current={current} /></slot>
    <main id="main"><slot /></main>
    <SiteFooter />
    <ReadmeNote />
  </body>
</html>
