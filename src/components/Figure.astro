---
interface Props {
  no: number;
  caption: string;
}

const { no, caption } = Astro.props;
const number = String(no).padStart(2, '0');
---

<figure>
  <div class="figure-content"><slot /></div>
  <figcaption>Fig. {number} · {caption}</figcaption>
</figure>

<style>
  figure {
    min-width: 0;
    max-width: 100%;
    margin: 2.25rem 0 2.5rem;
    padding: clamp(1rem, 3vw, 1.75rem) clamp(1rem, 3vw, 1.5rem) 1rem;
    border: 1px dashed var(--dashed-line);
    border-radius: 0.125rem;
  }

  .figure-content {
    min-width: 0;
    overflow-x: auto;
  }

  figcaption {
    margin-top: 1.375rem;
    color: var(--dark-grey);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
</style>
