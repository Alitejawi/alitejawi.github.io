---
// A fixed README button on every page. It opens a personal note in a panel that
// grows out of the bottom right corner. The About page holds the same bio as a
// normal page, so nothing here is needed to read the site without JavaScript.
import { site } from '../data/site';
import { bio } from '../data/bio';
import espresso from '../data/espresso.json';
import { formatCount } from '../../scripts/bump-espresso.mjs';

const sections = [
  { id: 'readme-why', label: '001 / Why I build things' },
  { id: 'readme-how', label: '002 / How I work' },
  { id: 'readme-who', label: '003 / Who am I' },
];
const facts = [
  { label: 'Espressos consumed', value: formatCount(espresso.count) },
  { label: 'Countries visited', value: bio.facts.countries },
  { label: 'Music', value: bio.facts.music },
];
---

<button class="readme-open" type="button" data-readme-open aria-haspopup="dialog" hidden>
  <span class="readme-open-label">Readme</span>
  <span class="readme-open-plus" aria-hidden="true">+</span>
</button>

<dialog class="readme" data-readme aria-labelledby="readme-title">
  <nav class="readme-toc" aria-label="README sections">
    {sections.map(({ id, label }, index) => (
      <a href={`#${id}`} aria-current={index === 0 ? 'location' : undefined}>{label}</a>
    ))}
    <span class="readme-toc-end">Thank you for reading</span>
  </nav>

  <div class="readme-body" data-readme-body>
    <header class="readme-head">
      <div>
        <h2 id="readme-title">Readme / {site.name}</h2>
        <p>A personal note</p>
      </div>
      <button class="readme-close" type="button" data-readme-close autofocus>
        <span class="readme-close-x" aria-hidden="true">X</span>
        <span class="readme-close-label">Close</span>
      </button>
    </header>

    <section id={sections[0].id}>
      <h3>{sections[0].label}</h3>
      <p>{bio.copy.solved}</p>
      <p>
        Brain started because I kept saving things and could never find them again. The
        Daily Diff started because there was more worth knowing each morning than time to
        read it.
      </p>
    </section>

    <section id={sections[1].id}>
      <h3>{sections[1].label}</h3>
      <p>{bio.copy.people}</p>
      <p>
        I measure what I build. Brain's search is scored on the same 50 test queries
        before and after a change, and the numbers on this site carry their dates.
      </p>
      <p>
        I write down what breaks. In the summer of 2026, one part of my pipeline did
        nothing for ten weeks while all eight of my checks stayed green. I replaced those
        checks with ones that look at what actually arrived, and{' '}
        <a href="/projects/brain/#what-i-changed-after-launch">wrote up what happened</a>.
      </p>
    </section>

    <section id={sections[2].id}>
      <h3>{sections[2].label}</h3>
      <p>{bio.copy.intro}</p>
      <p>{bio.copy.ai}</p>
      <div class="readme-facts">
        <p class="readme-facts-head"><span>A few personal facts</span><span>{site.location}</span></p>
        <dl>
          {facts.map(({ label, value }) => (
            <div>
              <dt>{label}</dt>
              <span class="readme-facts-leader" aria-hidden="true"></span>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      </div>
      <p>
        Find me on <a href={site.links.github}>GitHub</a> and{' '}
        <a href={site.links.linkedin}>LinkedIn</a>, or write to{' '}
        <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </section>
  </div>
</dialog>

<script>
  const note = document.querySelector<HTMLDialogElement>('[data-readme]');
  const open = document.querySelector<HTMLButtonElement>('[data-readme-open]');

  if (note && open && typeof note.showModal === 'function') {
    const body = note.querySelector<HTMLElement>('[data-readme-body]')!;
    const links = [...note.querySelectorAll<HTMLAnchorElement>('.readme-toc a')];
    const sections = links.map((link) => note.querySelector<HTMLElement>(link.hash)!);

    const markCurrent = () => {
      let current = 0;
      // Layout offsets, not getBoundingClientRect: the panel is scaled while it opens.
      sections.forEach((section, index) => {
        if (section.offsetTop - body.scrollTop <= body.clientHeight * 0.35) current = index;
      });
      // The short last section never reaches the upper part of the panel.
      if (body.scrollTop + body.clientHeight >= body.scrollHeight - 2) current = sections.length - 1;
      links.forEach((link, index) => {
        if (index === current) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };

    open.hidden = false;
    open.addEventListener('click', () => {
      note.showModal();
      markCurrent();
    });
    note.querySelector('[data-readme-close]')?.addEventListener('click', () => note.close());
    // The panel's children cover it completely, so a click on the dialog itself is a click on the backdrop.
    note.addEventListener('click', (event) => {
      if (event.target === note) note.close();
    });
    links.forEach((link, index) => {
      link.addEventListener('click', (event) => {
        // Scroll inside the panel without adding a #hash to the address or the history.
        event.preventDefault();
        sections[index].scrollIntoView();
      });
    });
    body.addEventListener('scroll', markCurrent, { passive: true });
  }
</script>

<style is:global>
  /* Global on purpose: ::backdrop and @starting-style must match the same selectors as the open state. */

  .readme-open {
    position: fixed;
    right: 1.375rem;
    bottom: 1.375rem;
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
    padding: 0;
    border: 0;
    border-radius: 0.625rem;
    background: none;
    color: var(--paper);
    cursor: pointer;
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    transition: transform 160ms var(--ease-out);
  }

  .readme-open[hidden] {
    display: none;
  }

  .readme-open:active {
    transform: scale(0.97);
  }

  .readme-open-label,
  .readme-open-plus {
    background: var(--ink);
    background-image: radial-gradient(rgb(255 255 255 / 6%) 1px, transparent 1px);
    background-size: 3px 3px;
    box-shadow: 0 8px 22px rgb(0 0 0 / 18%);
  }

  .readme-open-label {
    position: relative;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.75rem;
  }

  .readme-open-label::after {
    content: '';
    position: absolute;
    top: -0.1875rem;
    right: -0.1875rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .readme-open-plus {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: 0.5rem;
    font-size: 1.25rem;
    transition: transform 200ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .readme-open:hover .readme-open-plus {
      transform: rotate(90deg);
    }
  }

  /* The panel. Closed is the resting style, so opening and closing are both plain transitions. */
  .readme {
    position: fixed;
    inset: auto 1rem 1rem auto;
    width: min(60rem, calc(100vw - 2rem));
    max-width: none;
    height: auto;
    max-height: calc(100dvh - 2rem);
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: 0.875rem;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 30px 80px rgb(0 0 0 / 35%);
    opacity: 0;
    transform: scale(0.6) translateY(1rem);
    transform-origin: bottom right;
    transition:
      opacity 160ms var(--ease-out),
      transform 160ms var(--ease-out),
      overlay 160ms allow-discrete,
      display 160ms allow-discrete;
  }

  .readme[open] {
    display: flex;
    opacity: 1;
    transform: none;
    transition-duration: 280ms;
  }

  @starting-style {
    .readme[open] {
      opacity: 0;
      transform: scale(0.6) translateY(1rem);
    }
  }

  .readme::backdrop {
    background-color: rgb(35 35 35 / 0%);
    transition:
      background-color 160ms ease,
      overlay 160ms allow-discrete,
      display 160ms allow-discrete;
  }

  .readme[open]::backdrop {
    background-color: rgb(35 35 35 / 50%);
    transition-duration: 280ms;
  }

  @starting-style {
    .readme[open]::backdrop {
      background-color: rgb(35 35 35 / 0%);
    }
  }

  /* The page behind stays put while the note is open. */
  html:has(.readme[open]) {
    overflow: hidden;
  }

  .readme-toc {
    display: flex;
    flex: 0 0 13rem;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.625rem 1.125rem;
    border-right: 1px dashed var(--dashed-line);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .readme-toc a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--dark-grey);
    text-decoration: none;
  }

  .readme-toc a:hover,
  .readme-toc a[aria-current] {
    color: var(--ink);
  }

  .readme-toc a[aria-current]::before {
    content: '';
    flex: none;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .readme-toc-end {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--dashed-line);
    color: var(--dark-grey);
    font-size: 0.6875rem;
  }

  .readme-body {
    flex: 1;
    min-width: 0;
    padding: 0 2.125rem 2.5rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    scroll-behavior: smooth;
    /* Sections stop below the sticky header when a contents link scrolls to them. */
    scroll-padding-top: 6.5rem;
  }

  .readme-head {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
    padding-block: 1.625rem 1.25rem;
    border-bottom: 1px solid var(--mid-grey);
    background: var(--paper);
  }

  .readme-head h2 {
    margin: 0 0 0.375rem;
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .readme-head p {
    margin: 0;
    color: var(--dark-grey);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .readme-close {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.1875rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--paper);
    cursor: pointer;
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .readme-close span {
    background: var(--ink);
  }

  .readme-close-x {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: 0.5rem;
    font-size: 0.9375rem;
  }

  .readme-close-label {
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    font-size: 0.6875rem;
  }

  .readme section {
    padding-block: 2.125rem 1.875rem;
    border-bottom: 1px solid var(--mid-grey);
  }

  .readme section:last-of-type {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .readme h3 {
    margin: 0 0 1.125rem;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .readme section > p {
    max-width: 62ch;
    margin: 0 0 1rem;
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .readme section > p:last-child {
    margin-bottom: 0;
  }

  .readme-facts {
    max-width: 24rem;
    margin-block: 1.375rem;
    border: 1px dashed var(--dashed-line);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .readme-facts-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin: 0;
    padding: 0.75rem 0.875rem;
    border-bottom: 1px dashed var(--dashed-line);
  }

  .readme-facts-head span:last-child {
    color: var(--dark-grey);
  }

  .readme-facts dl {
    display: grid;
    gap: 0.375rem;
    margin: 0;
    padding: 0.75rem 0.875rem;
  }

  .readme-facts dl div {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .readme-facts dd {
    flex: none;
    margin: 0;
    white-space: nowrap;
  }

  .readme-facts-leader {
    flex: 1 0 1.5rem;
    border-bottom: 1px dotted var(--dashed-line);
    transform: translateY(-0.2em);
  }

  /* Phones: the note takes the whole screen and the contents column goes. */
  @media (width < 45rem) {
    .readme {
      inset: 0;
      width: 100%;
      height: 100%;
      max-height: none;
      border-radius: 0;
    }

    .readme-toc {
      display: none;
    }

    .readme-body {
      padding-inline: 1.25rem;
    }
  }

  @media print {
    .readme-open {
      display: none;
    }
  }
</style>
