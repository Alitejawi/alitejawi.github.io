---
import Figure from './Figure.astro';

const metrics = [
  { label: 'hit@5', description: 'the right note in the top 5', before: 42, after: 68 },
  { label: 'hit@1', description: 'the right note first', before: 22, after: 40 },
];
---

<Figure no={1} caption="Before and after on the same 50 test queries, 9 November 2026">
  <div class="metrics">
    {metrics.map(({ label, description, before, after }) => (
      <div class="metric" role="group" aria-label={`${label}: ${description}`}>
        <div class="metric-heading">
          <span class="label">{label}</span>
          <span class="description">{description}</span>
        </div>
        <div class="bar-row">
          <span>Before</span>
          <span class="track" aria-hidden="true"><span class="bar before" style={{ width: `${before}%` }} /></span>
          <span class="value">{before}%</span>
        </div>
        <div class="bar-row">
          <span>After</span>
          <span class="track" aria-hidden="true"><span class="bar after" style={{ width: `${after}%` }} /></span>
          <span class="value">{after}%</span>
        </div>
      </div>
    ))}
  </div>
</Figure>

<style>
  .metrics {
    display: grid;
    gap: 1.75rem;
  }

  .metric-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin-bottom: 0.75rem;
  }

  .description {
    color: var(--dark-grey);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .bar-row {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) 4ch;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .track {
    height: 0.875rem;
    background: var(--ghost-grey);
  }

  .bar {
    display: block;
    height: 100%;
  }

  .before {
    background: var(--dark-grey);
  }

  .after {
    border-right: 3px solid var(--accent);
    background: var(--ink);
  }

  .value {
    white-space: nowrap;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
</style>
