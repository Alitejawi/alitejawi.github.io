---
interface Props {
  label: string;
  value?: string;
  href?: string;
  current?: boolean;
}

const { label, value, href, current = false } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  class:list={['receipt-line', { current }]}
  href={href}
  aria-current={current ? (href?.startsWith('#') ? 'location' : 'page') : undefined}
>
  <span class="receipt-label">{label}</span>
  {value !== undefined && (
    <>
      <span class="leader" aria-hidden="true"></span>
      <span class="receipt-value">{value}</span>
    </>
  )}
</Tag>

<style>
  .receipt-line {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    min-width: 0;
    margin-block: 0.375rem;
    color: inherit;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .receipt-label,
  .receipt-value {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .receipt-value {
    max-width: 45%;
    text-align: right;
  }

  .leader {
    flex: 1 0 0.75rem;
    border-bottom: 1px dotted var(--dashed-line);
    transform: translateY(-0.2em);
  }

  a:hover .receipt-label,
  .current .receipt-label {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .current::before {
    content: '';
    flex: 0 0 0.375rem;
    width: 0.375rem;
    height: 0.375rem;
    align-self: center;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
