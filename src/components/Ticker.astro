---
import { site } from '../data/site';

interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<div class="ticker" aria-label="Status updates">
  <div class="ticker-track" data-ticker-track>
    {[false, true].map((duplicate) => (
      <ul class="ticker-group" aria-hidden={duplicate ? 'true' : undefined}>
        {items.map((item) => <li>{item}</li>)}
        <li>
          Amsterdam <span data-clock data-time-zone={site.timeZone}>--:--</span>
        </li>
      </ul>
    ))}
  </div>
</div>

<script>
  import '../scripts/clock';
</script>

<style>
  .ticker {
    overflow: hidden;
    min-width: 0;
    border-radius: 0.25rem;
    background: var(--ghost-grey);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker-scroll 30s linear infinite;
  }

  .ticker-group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    margin: 0;
    padding: 0.375rem 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    white-space: nowrap;
  }

  li::after {
    content: '·';
    padding-inline: 1.5rem;
    color: var(--dark-grey);
  }

  [data-clock] {
    font-variant-numeric: tabular-nums;
  }

  .ticker:hover .ticker-track {
    animation-play-state: paused;
  }

  @keyframes ticker-scroll {
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      display: block;
      width: auto;
      animation: none;
      transform: none;
    }

    .ticker-group {
      flex-wrap: wrap;
      gap: 0.375rem 1rem;
      padding: 0.5rem 0.625rem;
    }

    .ticker-group[aria-hidden='true'] {
      display: none;
    }

    li {
      display: block;
      min-width: 0;
      white-space: normal;
      overflow-wrap: anywhere;
    }

    li::after {
      content: none;
    }
  }
</style>
