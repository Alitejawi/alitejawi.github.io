---
import { site } from '../data/site';

interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<div class="ticker" role="group" aria-label="Status updates" data-ticker>
  <div class="ticker-track" data-ticker-track>
    {[false, true].map((duplicate) => (
      <ul class="ticker-group" aria-hidden={duplicate ? 'true' : undefined}>
        {items.map((item) => <li>{item}</li>)}
        <li>
          {site.location} <span data-clock data-time-zone={site.timeZone}>--:--</span>
        </li>
      </ul>
    ))}
  </div>
  {/* Shown on keyboard focus only; without JavaScript it stays hidden because it could do nothing. */}
  <button type="button" class="ticker-toggle" data-ticker-toggle hidden>
    <span data-ticker-action>Pause</span><span class="rest"> the status ticker</span>
  </button>
</div>

<script>
  import '../scripts/clock';
  import '../scripts/ticker';
</script>

<style>
  .ticker {
    position: relative;
    overflow: hidden;
    min-width: 0;
    cursor: pointer;
    border-radius: 0.25rem;
    background: var(--ghost-grey);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker-scroll 30s linear infinite;
  }

  .ticker-group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    margin: 0;
    padding: 0.375rem 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    white-space: nowrap;
  }

  li::after {
    content: '·';
    padding-inline: 1.5rem;
    color: var(--dark-grey);
  }

  [data-clock] {
    font-variant-numeric: tabular-nums;
  }

  .ticker[data-paused] .ticker-track {
    animation-play-state: paused;
  }

  /* Hover pauses for a mouse only. On a touch screen a tap leaves "hover" stuck on, which
     would keep the ticker paused after the tap that restarts it. */
  @media (hover: hover) and (pointer: fine) {
    .ticker:hover .ticker-track {
      animation-play-state: paused;
    }
  }

  /* Off screen until it has keyboard focus, then a small label at the end of the strip. */
  .ticker-toggle {
    position: absolute;
    inset: 0 0 0 auto;
    padding: 0 0.625rem;
    border: 0;
    background: var(--ink);
    color: var(--paper);
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }

  .ticker-toggle:not(:focus-visible) {
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .ticker-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  /* The full name is for screen readers; on screen the one word is enough. */
  .ticker-toggle .rest {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @keyframes ticker-scroll {
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Nothing moves, so there is nothing to pause. */
    .ticker {
      cursor: auto;
    }

    .ticker-toggle {
      display: none;
    }

    .ticker-track {
      display: block;
      width: auto;
      animation: none;
      transform: none;
    }

    .ticker-group {
      flex-wrap: wrap;
      gap: 0.375rem 1rem;
      padding: 0.5rem 0.625rem;
    }

    .ticker-group[aria-hidden='true'] {
      display: none;
    }

    li {
      display: block;
      min-width: 0;
      white-space: normal;
      overflow-wrap: anywhere;
    }

    li::after {
      content: none;
    }
  }
</style>
