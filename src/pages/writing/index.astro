---
import Base from '../../layouts/Base.astro';
import Receipt from '../../components/Receipt.astro';
import ReceiptLine from '../../components/ReceiptLine.astro';
import { site } from '../../data/site';
import { formatNo, getNotes, readMinutes } from '../../lib/notes';

const notes = await getNotes();
// "No. 09 · Title", as on the homepage receipt; an unnumbered note is its title alone.
// npm run dev also lists drafts and scheduled notes, and says which they are.
const label = (note: (typeof notes)[number]) => [
  note.status === 'draft' ? 'Draft' : note.status === 'scheduled' ? 'Scheduled' : null,
  note.no !== null ? formatNo(note.no) : null,
  note.data.title,
].filter(Boolean).join(' · ');
---

<Base title={`Writing · ${site.name}`} description="Field notes on systems, scripts, and automation.">
  <h1>Writing</h1>
  <p class="feed label"><a href="/feed.xml">RSS feed</a></p>
  <div class="writing-receipt">
    <Receipt title="Field notes" aside={`${notes.length} notes`} footer="Thank you for reading">
      <ol class="notes" role="list">
        {notes.map((note) => (
          <li>
            <h3><ReceiptLine label={label(note)} value={`${readMinutes(note.body ?? '')} min`} href={`/posts/${note.data.slug}/`} /></h3>
            <p class="note-description">{note.data.description}</p>
            {site.showDates && (
              <time datetime={note.data.date.toISOString()}>
                {note.data.date.toLocaleDateString('en-GB', { timeZone: site.timeZone, dateStyle: 'long' })}
              </time>
            )}
          </li>
        ))}
      </ol>
    </Receipt>
  </div>
</Base>

<style>
  .feed {
    margin: 1rem 0 0;
    color: var(--dark-grey);
  }

  .feed a {
    text-decoration-thickness: 1px;
  }

  .writing-receipt {
    max-width: 48rem;
    margin-top: 2.5rem;
  }

  .notes {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .notes h3 {
    margin: 0;
    font: inherit;
  }

  .note-description,
  .notes time {
    display: block;
    margin: 0;
    color: var(--dark-grey);
    font-family: var(--font-body);
    font-size: var(--text-md);
    letter-spacing: 0;
    line-height: 1.5;
    text-transform: none;
  }
</style>
