---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Receipt from '../../components/Receipt.astro';
import ReceiptLine from '../../components/ReceiptLine.astro';
import { site } from '../../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
// "Brain: an AI knowledge base" heads its receipt as "Brain", with "an AI knowledge base" on its line.
const parts = (title: string) => {
  const [name, ...rest] = title.split(':');
  return { name, kind: rest.join(':').trim() };
};
---

<Base title={`Projects · ${site.name}`} description="Brain and The Daily Diff: AI systems I build and run every day.">
  <h1>Projects</h1>
  <p class="lede">AI systems I build and run every day.</p>
  <ul class="projects" role="list">
    {projects.map((project, index) => {
      const { name, kind } = parts(project.data.title);
      return (
        <li>
          <Receipt title={name} href={`/projects/${project.id}/`} aside={`No. ${String(index + 1).padStart(2, '0')}`}>
            <div>
              <ReceiptLine label={kind} value={project.data.receiptValue} note={project.data.receiptNote} />
            </div>
            <p class="project-note">{project.data.oneLiner}</p>
            {(project.data.image || site.showPlaceholders) && (
              <div class="project-image">
                {project.data.image ? (
                  <img src={project.data.image} alt="" width="640" height="400" loading="lazy" />
                ) : (
                  <span class="label muted">Image coming soon</span>
                )}
              </div>
            )}
          </Receipt>
        </li>
      );
    })}
  </ul>
</Base>

<style>
  .lede {
    margin-top: 1rem;
    color: var(--dark-grey);
    font-size: var(--text-lg);
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .projects li {
    display: grid;
    min-width: 0;
  }

  .project-note {
    margin: 0;
    color: var(--dark-grey);
    font-family: var(--font-body);
    font-size: var(--text-md);
    letter-spacing: 0;
    line-height: 1.5;
    text-transform: none;
  }

  .project-image {
    display: grid;
    place-items: center;
    aspect-ratio: 8 / 5;
    border: 1px dashed var(--dashed-line);
    background-image: radial-gradient(var(--mid-grey) 0.5px, transparent 0.5px);
    background-size: 6px 6px;
  }

  .project-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (width < 700px) {
    .projects {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
