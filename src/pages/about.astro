---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Receipt from '../components/Receipt.astro';
import ReceiptLine from '../components/ReceiptLine.astro';
import Chip from '../components/Chip.astro';
import { site } from '../data/site';
import espresso from '../data/espresso.json';
import { formatCount } from '../../scripts/bump-espresso.mjs';
---

<Base
  title={`About · ${site.name}`}
  description="About Ali Al-Itejawi: security, systems and IT, the AI systems I build, and espresso."
>
  <Nav slot="nav" current="about" />
  <h1>About</h1>
  <div class="about">
    <div class="about-copy">
      <p>
        I'm Ali, a {site.role} in {site.location}. My background is in security, systems
        and IT. For years that has meant Okta, Google Workspace, Jamf, and the scripts
        between them.
      </p>
      <p>
        I like problems that stay solved. If something has to be done every week, I'd
        rather automate it, and a quiet week is how I know it worked.
      </p>
      <p>
        These days I also build AI systems for myself and run them daily. One reads
        everything I save so I can find it again. Another picks my morning reading and
        prints it on a receipt printer.
      </p>
      <p>
        I work best close to the people who have the problem, and I ask a lot of
        questions before I build anything.
      </p>
      <p class="contact">Say hello: <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
    <Receipt title="A few personal facts" aside={site.location}>
      <div>
        <ReceiptLine label="Espressos consumed" value={formatCount(espresso.count)} />
        <Chip text="+2 every day" />
      </div>
      <div>
        <ReceiptLine label="Countries visited" value="29" />
        <ReceiptLine label="Music" value="Lo-fi, Synthwave" />
      </div>
    </Receipt>
  </div>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 4rem);
    margin-top: 2.5rem;
  }

  .about-copy {
    max-width: 40rem;
    min-width: 0;
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .about-copy p {
    margin-bottom: 1.5rem;
  }

  .about-copy .contact {
    margin-bottom: 0;
  }

  @media (width < 900px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
